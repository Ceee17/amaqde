# ==============================================================================
# AMAQDE — Environment Configuration Example (.env.example)
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Antigravity OAuth 2.1 & Multi-Agent Session
# ------------------------------------------------------------------------------
# Provide your user OAuth authorization code.
# You can generate a fresh code by visiting:
#   http://localhost:3000/api/oauth/authorize?client_id=antigravity-ide-mcp-client&response_type=code
# Or paste any custom authorization code starting with "ag_authz_".
ANTIGRAVITY_OAUTH_CODE=ag_authz_example_user_session

# ------------------------------------------------------------------------------
# 2. Microservice URLs & Ports
# ------------------------------------------------------------------------------
# High-speed native Rust Mathematical Kernel (Sinkhorn, Sheaf, WDRO, OU Stopping)
SWRT_RUST_KERNEL_URL=http://localhost:4001

# Python Audit Tap & DuckDB Merkle Bridge
AUDIT_TAP_PORT=4002
AUDIT_TAP_URL=http://localhost:4002

# Project root directory for local DuckDB audit vault storage
SWRT_REPO_ROOT=.

# ------------------------------------------------------------------------------
# 3. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
